  "authors": [
    "yucktheslime"
  ],
  "contact": {
    "sources": "https://github.com/yucktheslime/mca-player2-bridge",
    "issues": "https://github.com/yucktheslime/mca-player2-bridge/issues"
  },
  "license": "LGPL-3.0-or-later",
  "environment": "*",
